<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- WinForms only for the tray notification icon; its namespace is not imported globally (see below). -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>maison</AssemblyName>
    <RootNamespace>Maison</RootNamespace>
    <Version>0.0.5</Version>
    <Product>maison</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\brand\maison.ico</ApplicationIcon>

    <!-- dotnet publish -> one self-contained Maison.exe: runs on any 64-bit Windows 10/11 PC, no .NET install needed -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <!-- Kestrel for the phone web portal (HTTPS + WebSockets) -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- maison brand assets (generated from branding/maison-icon.svg) -->
    <Resource Include="Assets\brand\maison.ico;Assets\brand\maison-256.png;Assets\brand\maison-32.png" />
    <EmbeddedResource Include="Assets\Repair-Ollama.ps1" LogicalName="Repair-Ollama.ps1" />
    <!-- xterm.js (MIT) for the in-app terminal; served offline from the exe -->
    <EmbeddedResource Include="Assets\terminal\*.js;Assets\terminal\*.css" LogicalName="terminal/%(Filename)%(Extension)" />
    <!-- phone web portal pages -->
    <EmbeddedResource Include="Assets\portal\*.html" LogicalName="portal/%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- dotnet publish names the exe after the version (maison-0.0.5.exe), so downloads say which build they are.
       Only the file name changes: the app, its settings and its process are still "maison". Plain builds keep maison.exe. -->
  <Target Name="VersionedPublishName" AfterTargets="Publish">
    <PropertyGroup>
      <_PublishedExe>$([System.IO.Path]::Combine($(PublishDir), '$(AssemblyName).exe'))</_PublishedExe>
      <_VersionedExe>$([System.IO.Path]::Combine($(PublishDir), '$(AssemblyName)-$(Version).exe'))</_VersionedExe>
    </PropertyGroup>
    <Delete Files="$(_VersionedExe)" Condition="Exists('$(_PublishedExe)')" />
    <Move SourceFiles="$(_PublishedExe)" DestinationFiles="$(_VersionedExe)" Condition="Exists('$(_PublishedExe)')" />
    <Message Importance="high" Text="maison -> $(_VersionedExe)" />
  </Target>

</Project>
