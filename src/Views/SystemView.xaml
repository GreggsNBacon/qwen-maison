<UserControl x:Class="Maison.Views.SystemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:c="clr-namespace:Maison.Controls">
  <UserControl.Resources>
    <DataTemplate x:Key="ProcRow">
      <Grid Margin="0,3">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}" ToolTip="{Binding Tip}" />
        <TextBlock Grid.Column="1" Text="{Binding Value}" FontFamily="Cascadia Mono, Consolas" Margin="12,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20,4,28,28">
      <TextBlock Text="System" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
      <TextBlock Text="What this PC is and what it's doing right now · refreshed every 2 seconds" FontSize="14" Margin="0,2,0,16"
                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

      <Border x:Name="WarnBox" Visibility="Collapsed" Margin="0,0,0,12" Padding="12,8" CornerRadius="6" Background="#22E5B454" BorderBrush="#66E5B454" BorderThickness="1">
        <StackPanel Orientation="Horizontal">
          <ui:SymbolIcon Symbol="Warning20" Foreground="#E5B454" Margin="0,0,8,0" />
          <TextBlock x:Name="WarnText" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" MaxWidth="1000" />
        </StackPanel>
      </Border>

      <UniformGrid Columns="3" Margin="-6,0,-6,6">
        <ui:Card Margin="6" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
          <StackPanel>
            <TextBlock Text="Processor" Style="{StaticResource MetricLabel}" />
            <TextBlock x:Name="CpuName" Text="—" Style="{StaticResource MetricValue}" FontSize="15" TextWrapping="Wrap" />
            <TextBlock x:Name="CpuSub" Style="{StaticResource MetricSub}" />
            <c:ArcGauge x:Name="GCpu" Maximum="100" Warn="80" Danger="95" Caption="Usage" Height="130" Margin="0,8,0,0"
                        ToolTip="Total CPU usage across all cores" />
            <TextBlock Text="CPU temperature isn't exposed to apps by Windows without the board vendor's tools, so it isn't shown."
                       FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
          </StackPanel>
        </ui:Card>
        <ui:Card Margin="6" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
          <StackPanel>
            <TextBlock Text="Memory" Style="{StaticResource MetricLabel}" />
            <TextBlock x:Name="RamName" Text="—" Style="{StaticResource MetricValue}" FontSize="15" />
            <TextBlock x:Name="RamSub" Style="{StaticResource MetricSub}" />
            <c:ArcGauge x:Name="GRam" Maximum="32" Caption="In use" Height="130" Margin="0,8,0,0" ToolTip="System RAM in use" />
          </StackPanel>
        </ui:Card>
        <ui:Card Margin="6" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
          <StackPanel>
            <TextBlock Text="Graphics" Style="{StaticResource MetricLabel}" />
            <TextBlock x:Name="GpuName" Text="—" Style="{StaticResource MetricValue}" FontSize="15" TextWrapping="Wrap" />
            <TextBlock x:Name="GpuSub" Style="{StaticResource MetricSub}" TextWrapping="Wrap" />
            <c:ArcGauge x:Name="GVram" Maximum="24" Caption="VRAM" Height="130" Margin="0,8,0,0" ToolTip="GPU memory in use" />
          </StackPanel>
        </ui:Card>
      </UniformGrid>

      <UniformGrid Columns="3" Margin="-6,0,-6,6">
        <ui:Card Margin="6" VerticalAlignment="Stretch">
          <StackPanel>
            <TextBlock Text="Windows" Style="{StaticResource MetricLabel}" />
            <TextBlock x:Name="OsName" Text="—" Style="{StaticResource MetricValue}" FontSize="15" />
            <TextBlock x:Name="OsSub" Style="{StaticResource MetricSub}" />
          </StackPanel>
        </ui:Card>
        <ui:Card Margin="6" VerticalAlignment="Stretch">
          <StackPanel>
            <TextBlock Text="Model storage" Style="{StaticResource MetricLabel}" />
            <TextBlock x:Name="DiskName" Text="—" Style="{StaticResource MetricValue}" FontSize="15" />
            <TextBlock x:Name="DiskSub" Style="{StaticResource MetricSub}" />
          </StackPanel>
        </ui:Card>
        <ui:Card Margin="6" VerticalAlignment="Stretch" ToolTip="Resources used by Ollama itself. High CPU while generating means the model doesn't fit on the GPU.">
          <StackPanel>
            <TextBlock Text="Ollama" Style="{StaticResource MetricLabel}" />
            <TextBlock x:Name="OllamaName" Text="—" Style="{StaticResource MetricValue}" FontSize="15" />
            <TextBlock x:Name="OllamaSub" Style="{StaticResource MetricSub}" TextWrapping="Wrap" />
          </StackPanel>
        </ui:Card>
      </UniformGrid>

      <UniformGrid Columns="3" Margin="-6,0,-6,0">
        <ui:Card Margin="6" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
          <StackPanel>
            <TextBlock Text="GPU memory by app" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <ItemsControl x:Name="VramList" ItemTemplate="{StaticResource ProcRow}" />
            <TextBlock Text="Apps holding GPU memory leave less room for models. Overlays, browsers and games are the usual culprits."
                       FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
          </StackPanel>
        </ui:Card>
        <ui:Card Margin="6" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
          <StackPanel>
            <TextBlock Text="Busiest processes (CPU)" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <ItemsControl x:Name="CpuList" ItemTemplate="{StaticResource ProcRow}" />
          </StackPanel>
        </ui:Card>
        <ui:Card Margin="6" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
          <StackPanel>
            <TextBlock Text="Biggest processes (RAM)" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <ItemsControl x:Name="RamList" ItemTemplate="{StaticResource ProcRow}" />
          </StackPanel>
        </ui:Card>
      </UniformGrid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
