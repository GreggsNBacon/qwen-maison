<UserControl x:Class="Maison.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <UserControl.Resources>
    <Style x:Key="H" TargetType="TextBlock">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style x:Key="Sub" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,0,12" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
  </UserControl.Resources>
  <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28,4,28,28" MaxWidth="1100" HorizontalAlignment="Left">
      <TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
      <TextBlock Text="Saved automatically." FontSize="14" Margin="0,2,0,18" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

      <!-- Appearance -->
      <ui:Card Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="Accent colour" Style="{StaticResource H}" />
          <TextBlock Text="Used for buttons, toggles, selections and highlights. Purple matches the maison logo." Style="{StaticResource Sub}" />
          <WrapPanel x:Name="AccentPanel" />

          <TextBlock Text="Terminal colours" Style="{StaticResource H}" Margin="0,18,0,4" />
          <TextBlock Text="Applies to every terminal tab, pop-out window and the phone portal right away." Style="{StaticResource Sub}" />
          <WrapPanel x:Name="ThemePanel" />
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock Text="Font size" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <Slider x:Name="FontSizeSlider" Minimum="10" Maximum="22" Width="220" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="FontSize_Changed"
                    ToolTip="Terminal font size in points" />
            <TextBlock x:Name="FontSizeText" Text="14" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
          </StackPanel>
        </StackPanel>
      </ui:Card>

      <!-- Notifications -->
      <ui:Card Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="Idle notifications" Style="{StaticResource H}" />
          <TextBlock Text="When an agent you gave a task stops producing output for a while, maison marks its tab with a dot and tells you: a Windows notification and a flashing taskbar button when maison is in the background, a pop-up message when it's in front."
                     Style="{StaticResource Sub}" />
          <ui:ToggleSwitch x:Name="IdleNotify" Content="Notify me when a terminal goes idle" Click="Notify_Changed"
                           ToolTip="Show a notification when an agent finishes and waits for you" />
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock Text="Idle after" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <ui:NumberBox x:Name="IdleSeconds" Minimum="3" Maximum="600" SmallChange="1" Width="140" ValueChanged="Notify_Changed" SpinButtonPlacementMode="Inline"
                          ToolTip="Seconds without any output (after you've asked something) before the terminal counts as idle" />
            <TextBlock Text="seconds without output" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          </StackPanel>
          <ui:ToggleSwitch x:Name="IdleSound" Content="Play a sound" Margin="0,12,0,0" Click="Notify_Changed"
                           ToolTip="Play the Windows notification sound too" />
        </StackPanel>
      </ui:Card>

      <!-- Start commands -->
      <ui:Card Margin="0,0,0,12">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Start commands" Style="{StaticResource H}" />
              <TextBlock Text="What maison runs when you start Claude Code, Qwen Code or Chat. Model, context window, folder and permissions come from the Dashboard; everything else is here. The preview shows the exact command."
                         Style="{StaticResource Sub}" />
            </StackPanel>
            <ui:Button Grid.Column="1" Content="Reset to defaults" Icon="{ui:SymbolIcon ArrowReset24}" VerticalAlignment="Top" Click="ResetLaunch_Click"
                       ToolTip="Put every start-command option back to maison's defaults" />
          </Grid>

          <ui:ToggleSwitch x:Name="LTellCtx" Content="Tell the agent the real context window" Click="Launch_Changed"
                           ToolTip="Recommended. Claude Code and Qwen Code otherwise assume a 200K window for local models, so they keep going until Ollama's much smaller window overflows and the request fails. With this on, they compact the conversation in time." />
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock Text="Max reply length" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <ui:NumberBox x:Name="LMaxOut" Minimum="0" Maximum="131072" SmallChange="1024" LargeChange="4096" Width="170" ValueChanged="Launch_Changed" SpinButtonPlacementMode="Inline"
                          ToolTip="Most tokens one reply may use. 0 = automatic: a quarter of the context window (4K–32K), so the prompt and the reply both fit." />
            <TextBlock x:Name="LMaxOutHint" Text="tokens (0 = automatic)" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          </StackPanel>

          <TabControl x:Name="LTabs" Margin="0,16,0,0" SelectionChanged="LTabs_Changed">
            <TabItem Header="Claude Code" Tag="claude">
              <StackPanel Margin="4,12,4,4">
                <ui:ToggleSwitch x:Name="LClaudeContinue" Content="Continue the last conversation in this folder (--continue)" Click="Launch_Changed"
                                 ToolTip="Pick up where the previous Claude Code session in the working folder left off" />
                <ui:ToggleSwitch x:Name="LClaudeNoThink" Content="Turn off thinking (CLAUDE__CODE__DISABLE__THINKING)" Margin="0,10,0,0" Click="Launch_Changed"
                                 ToolTip="Leave out the thinking parameter. Faster replies; also a fix if a model or server rejects it." />
                <ui:ToggleSwitch x:Name="LClaudeNoTraffic" Content="No telemetry or update checks (CLAUDE__CODE__DISABLE__NONESSENTIAL__TRAFFIC)" Margin="0,10,0,0" Click="Launch_Changed"
                                 ToolTip="Keeps the session fully local: no usage reporting, error reporting or update checks" />
                <ui:ToggleSwitch x:Name="LClaudeNoCache" Content="No prompt caching (DISABLE__PROMPT__CACHING)" Margin="0,10,0,0" Click="Launch_Changed"
                                 ToolTip="Ollama doesn't use Anthropic-style prompt caching, so the cache hints are only noise" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <TextBlock Text="Compact at" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                  <ui:NumberBox x:Name="LClaudePct" Minimum="0" Maximum="100" SmallChange="5" Width="140" ValueChanged="Launch_Changed" SpinButtonPlacementMode="Inline"
                                ToolTip="Summarise the conversation when it reaches this % of the window (CLAUDE_AUTOCOMPACT_PCT_OVERRIDE). 0 = Claude Code's default. It can only make compaction earlier." />
                  <TextBlock Text="% of the window (0 = default)" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <TextBlock Text="Extra arguments" Style="{StaticResource SectionLabel}" Margin="0,14,0,4" />
                <ui:TextBox x:Name="LClaudeArgs" PlaceholderText="e.g. --verbose" FontFamily="Cascadia Mono, Consolas" TextChanged="Launch_Changed"
                            ToolTip="Added to the end of the claude command, exactly as typed" />
                <TextBlock Text="Extra environment variables (one KEY=value per line)" Style="{StaticResource SectionLabel}" Margin="0,12,0,4" />
                <TextBox x:Name="LClaudeEnv" AcceptsReturn="True" Height="70" FontFamily="Cascadia Mono, Consolas" VerticalScrollBarVisibility="Auto" TextChanged="Launch_Changed"
                         ToolTip="Set for this session only. Overrides maison's own values with the same name. Lines starting with # are ignored." />
              </StackPanel>
            </TabItem>
            <TabItem Header="Qwen Code" Tag="qwen">
              <StackPanel Margin="4,12,4,4">
                <ui:ToggleSwitch x:Name="LQwenContinue" Content="Continue the last conversation in this folder (--continue)" Click="Launch_Changed"
                                 ToolTip="Pick up where the previous Qwen Code session in the working folder left off" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <TextBlock Text="Compact at" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                  <ui:NumberBox x:Name="LQwenPct" Minimum="30" Maximum="100" SmallChange="5" Width="140" ValueChanged="Launch_Changed" SpinButtonPlacementMode="Inline"
                                ToolTip="Summarise the conversation when it reaches this % of the window (Qwen Code's context.autoCompactThreshold; its default is 85)" />
                  <TextBlock Text="% of the window" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <TextBlock Text="Request timeout" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                  <ui:NumberBox x:Name="LQwenTimeout" Minimum="30" Maximum="7200" SmallChange="30" Width="140" ValueChanged="Launch_Changed" SpinButtonPlacementMode="Inline"
                                ToolTip="How long Qwen Code waits for one reply. Local models on long prompts can take minutes; Qwen Code's own default is 2 minutes." />
                  <TextBlock Text="seconds" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <TextBlock Text="Extra arguments" Style="{StaticResource SectionLabel}" Margin="0,14,0,4" />
                <ui:TextBox x:Name="LQwenArgs" PlaceholderText="e.g. --max-subagent-depth 3" FontFamily="Cascadia Mono, Consolas" TextChanged="Launch_Changed"
                            ToolTip="Added to the end of the qwen command, exactly as typed" />
                <TextBlock Text="Extra environment variables (one KEY=value per line)" Style="{StaticResource SectionLabel}" Margin="0,12,0,4" />
                <TextBox x:Name="LQwenEnv" AcceptsReturn="True" Height="70" FontFamily="Cascadia Mono, Consolas" VerticalScrollBarVisibility="Auto" TextChanged="Launch_Changed"
                         ToolTip="Set for this session only. Overrides maison's own values with the same name. Lines starting with # are ignored." />
              </StackPanel>
            </TabItem>
            <TabItem Header="Chat" Tag="chat">
              <StackPanel Margin="4,12,4,4">
                <ui:ToggleSwitch x:Name="LChatVerbose" Content="Show speed after each reply (--verbose)" Click="Launch_Changed"
                                 ToolTip="ollama run prints tokens/s and timings after every answer" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <TextBlock Text="Thinking" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                  <ComboBox x:Name="LChatThink" Width="170" SelectionChanged="Launch_Changed"
                            ToolTip="Model default, always think (--think=true), or answer straight away (--think=false)" />
                </StackPanel>
                <TextBlock Text="Extra arguments" Style="{StaticResource SectionLabel}" Margin="0,14,0,4" />
                <ui:TextBox x:Name="LChatArgs" PlaceholderText="e.g. --hidethinking" FontFamily="Cascadia Mono, Consolas" TextChanged="Launch_Changed"
                            ToolTip="Added to the end of the ollama run command, exactly as typed" />
              </StackPanel>
            </TabItem>
          </TabControl>

          <TextBlock Text="Preview" Style="{StaticResource SectionLabel}" Margin="0,14,0,4" />
          <TextBox x:Name="LPreview" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap" MaxHeight="220"
                   VerticalScrollBarVisibility="Auto" ToolTip="Exactly what maison runs in the new session's PowerShell, with the current Dashboard selection" />
        </StackPanel>
      </ui:Card>

      <!-- Models -->
      <ui:Card Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="Models" Style="{StaticResource H}" />
          <TextBlock Text="maison records when each model was last used (launched or loaded). Models unused for longer than this are marked Stale on the Models page, so you know what's safe to uninstall."
                     Style="{StaticResource Sub}" />
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Mark as stale after" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <ui:NumberBox x:Name="StaleDays" Minimum="1" Maximum="365" SmallChange="1" Width="140" ValueChanged="Stale_Changed" SpinButtonPlacementMode="Inline"
                          ToolTip="Days without use before a model is marked stale" />
            <TextBlock Text="days unused" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          </StackPanel>

          <TextBlock Text="Model storage folder" Style="{StaticResource H}" Margin="0,18,0,4" />
          <TextBlock Text="Ollama keeps all models in one folder, so they can't be split across drives model by model — but you can move the whole store to any drive with more space. maison stops Ollama, moves the files, points Ollama at the new folder (OLLAMA_MODELS) and starts it again."
                     Style="{StaticResource Sub}" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock x:Name="ModelsDir" FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
              <TextBlock x:Name="ModelsDirSub" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <ui:Button Content="Open" Icon="{ui:SymbolIcon FolderOpen24}" Margin="8,0,0,0" Click="OpenModels_Click" ToolTip="Open the model folder in Explorer" />
              <ui:Button x:Name="BtnMoveModels" Content="Move…" Icon="{ui:SymbolIcon FolderArrowRight24}" Margin="8,0,0,0" Click="MoveModels_Click"
                         ToolTip="Choose a new folder (e.g. on a bigger drive) and move all models there" />
            </StackPanel>
          </Grid>
          <TextBox x:Name="MoveLog" Visibility="Collapsed" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="12" Height="110" Margin="0,10,0,0"
                   TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
        </StackPanel>
      </ui:Card>

      <!-- AI pool -->
      <ui:Card x:Name="AiCard" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="AI pool" Style="{StaticResource H}" />
          <TextBlock Style="{StaticResource Sub}"
                     Text="Run the AI on the PCs with good graphics cards, and use them from any PC at home. The agent works on the PC you're sitting at, with its files; only the model's thinking happens on an AI PC. With several AI PCs, a busy one hands work to a free one." />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="24" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- This PC is an AI PC -->
            <StackPanel>
              <TextBlock Text="Make this PC an AI PC" Style="{StaticResource SectionLabel}" />
              <ui:ToggleSwitch x:Name="ShareAiToggle" Content="Share this PC's AI with my other PCs" Click="ShareAi_Click"
                               ToolTip="Turn this on on the PC with the good graphics card. Paired PCs at home can then use this PC's models through maison (encrypted, with their own key). This doesn't change what this PC itself uses: that's the Pool switch. Ollama itself stays private. Windows asks for admin permission once to open maison's ports for your home network." />
              <TextBlock x:Name="ShareState" FontSize="12.5" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              <StackPanel x:Name="SharePanel" Margin="0,10,0,0" Visibility="Collapsed">
                <TextBlock Text="Pairing code (enter it once on the other PC)" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                  <TextBlock x:Name="PairCode" FontFamily="Cascadia Mono, Consolas" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center"
                             Foreground="{DynamicResource MaisonAccentTextBrush}" />
                  <ui:Button Content="New code" Appearance="Transparent" Margin="12,0,0,0" Click="NewCode_Click"
                             ToolTip="Make a new code. PCs already paired keep working." />
                </StackPanel>
                <TextBlock Text="Paired PCs" FontSize="12" Margin="0,10,0,2" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <ItemsControl x:Name="PairedList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                          <Run Text="{Binding Name, Mode=OneWay}" /><Run Text=" · last used " Foreground="{DynamicResource TextFillColorTertiaryBrush}" /><Run Text="{Binding LastSeen, Mode=OneWay, StringFormat='g'}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </TextBlock>
                        <ui:Button Grid.Column="1" Content="Remove" Appearance="Transparent" Padding="8,2" Tag="{Binding}" Click="Unpair_Click"
                                   ToolTip="This PC stops accepting it; it would need the code again" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="NoPaired" Text="None yet." FontSize="12.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="Keep maison running on this PC (minimised is fine) so the pool can use it. Your home network must be set to Private in Windows." />
              </StackPanel>
            </StackPanel>

            <!-- This PC uses the pool -->
            <StackPanel Grid.Column="2">
              <TextBlock Text="Use AI PCs from this PC" Style="{StaticResource SectionLabel}" />
              <ui:ToggleSwitch x:Name="UseRemoteToggle" Content="Use the pool" Click="UseRemote_Click"
                               ToolTip="On: Claude Code, Qwen Code and Chat on this PC use the AI PCs you've added (and this PC, if included), picking a free one for each request. Off: they use only this PC's own AI. Same switch as &quot;Pool&quot; in the title bar." />
              <ui:ToggleSwitch x:Name="IncludeThisToggle" Content="Include this PC" Margin="0,10,0,0" Click="IncludeThis_Click"
                               ToolTip="Only matters while the pool is on. On: this PC's own Ollama is one of the pool's PCs and takes work when it's free, so its models stay usable. Off: everything runs on the other PCs." />
              <TextBlock x:Name="RemoteState" FontSize="12.5" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              <ui:Button Content="Open the Pool page" Icon="{ui:SymbolIcon Server24}" Margin="0,10,0,0" Click="OpenPool_Click"
                         ToolTip="Find AI PCs at home, add them, see what they're doing and manage their models" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </ui:Card>
      <!-- Start with Windows -->
      <ui:Card Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="Start with Windows" Style="{StaticResource H}" />
          <TextBlock Style="{StaticResource Sub}"
                     Text="Open maison when you sign in to Windows. Useful on an AI PC, so the AI pool can always use it." />
          <ui:ToggleSwitch x:Name="StartWithWindows" x:FieldModifier="internal" Content="Start maison when I sign in" Click="AutoStart_Click"
                           ToolTip="Adds maison to your Windows start-up apps (just for you; no admin needed). You can also turn it off in Windows Settings → Apps → Startup." />
          <ui:ToggleSwitch x:Name="StartMinimized" x:FieldModifier="internal" Content="Start minimised" Margin="0,10,0,0" Click="AutoStart_Click"
                           ToolTip="Open maison minimised to the taskbar instead of in front" />
          <TextBlock x:Name="AutoStartState" FontSize="12.5" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
      </ui:Card>

      <!-- Updates -->
      <ui:Card Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="Updates" Style="{StaticResource H}" />
          <TextBlock Style="{StaticResource Sub}"
                     Text="maison looks for a newer version on GitHub when it starts and once a day. If there is one, a button in the title bar takes you to the download." />
          <ui:ToggleSwitch x:Name="AutoUpdateCheck" Content="Check for updates automatically" Click="AutoUpdate_Click"
                           ToolTip="Asks GitHub for the latest maison release. Nothing about you or this PC is sent." />
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <ui:Button x:Name="BtnCheckUpdate" Content="Check now" Icon="{ui:SymbolIcon ArrowSync24}" Click="CheckUpdate_Click" />
            <TextBlock x:Name="UpdateState" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          </StackPanel>
        </StackPanel>
      </ui:Card>

      <!-- Web portal -->
      <ui:Card Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="Web portal (phone access)" Style="{StaticResource H}" />
          <TextBlock Style="{StaticResource Sub}">
            Open maison from your phone's browser: live stats, health, and the same terminal sessions as this window (mirrored, not copies — type on either).
            Protected by one password over HTTPS; each device stays signed in until you sign it out below. By default only devices on your home network can connect.
          </TextBlock>

          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="16" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Password (8+ characters)" Style="{StaticResource SectionLabel}" />
              <ui:PasswordBox x:Name="Pw1" PlaceholderText="New password" ToolTip="The one password the portal asks for. Stored only as a salted hash." />
              <ui:PasswordBox x:Name="Pw2" PlaceholderText="Repeat it" Margin="0,8,0,0" />
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <ui:Button Content="Set password" Appearance="Primary" Icon="{ui:SymbolIcon Key24}" Click="SetPassword_Click"
                           ToolTip="Save the password. Changing it signs out every remembered device." />
                <TextBlock x:Name="PwState" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Port" Style="{StaticResource SectionLabel}" />
              <StackPanel Orientation="Horizontal">
                <ui:NumberBox x:Name="Port" Minimum="1024" Maximum="65535" Width="160" SpinButtonPlacementMode="Hidden" ValueChanged="Port_Changed"
                              ToolTip="maison's own port for the portal (picked at random on first run so it's unique to this PC)" />
                <ui:Button Content="Random" Margin="8,0,0,0" Click="RandomPort_Click" ToolTip="Pick a new random port" />
              </StackPanel>
              <ui:ToggleSwitch x:Name="AllowInternet" Content="Allow connections from outside my network" Margin="0,14,0,0" Click="AllowInternet_Click"
                               ToolTip="Off: only your home network (and VPNs like Tailscale) can connect. On: needed only if you forward the port on your router — think twice." />
            </StackPanel>
          </Grid>

          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <ui:ToggleSwitch x:Name="PortalOn" Content="Web portal on" Click="PortalOn_Click"
                             ToolTip="Start or stop the portal. Windows may ask once whether maison can use the network: allow Private networks." />
            <TextBlock x:Name="PortalState" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="12.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          </StackPanel>

          <StackPanel x:Name="PortalInfo" Margin="0,12,0,0">
            <TextBlock Text="Open on your phone (same Wi-Fi)" Style="{StaticResource SectionLabel}" />
            <ItemsControl x:Name="UrlList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <ui:Button Content="Copy" Appearance="Transparent" Margin="8,0,0,0" Padding="8,2" Tag="{Binding}" Click="CopyUrl_Click" ToolTip="Copy this address" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="CertText" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

            <TextBlock Text="Signed-in devices" Style="{StaticResource SectionLabel}" Margin="0,14,0,4" />
            <ItemsControl x:Name="DeviceList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                      <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                        <Run Text="{Binding Address, Mode=OneWay}" /><Run Text=" · last seen " /><Run Text="{Binding LastSeen, Mode=OneWay, StringFormat='g'}" />
                      </TextBlock>
                    </StackPanel>
                    <ui:Button Grid.Column="1" Content="Sign out" Tag="{Binding}" Click="Revoke_Click" ToolTip="Sign this device out; it will need the password again" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="NoDevices" Text="No devices yet." FontSize="12.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
          </StackPanel>
        </StackPanel>
      </ui:Card>
    </StackPanel>
  </ScrollViewer>
</UserControl>
