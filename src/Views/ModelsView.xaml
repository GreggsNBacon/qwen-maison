<UserControl x:Class="Maison.Views.ModelsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28,4,28,28">

      <!-- Header -->
      <Grid Margin="0,0,0,18">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Models" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
          <TextBlock x:Name="DiskText" Text="…" FontSize="14" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <ui:Button Grid.Column="1" Content="Refresh" Icon="{ui:SymbolIcon ArrowClockwise24}" VerticalAlignment="Center"
                   Click="Refresh_Click" ToolTip="Reload the list of installed models and free disk space" />
      </Grid>

      <!-- Install by name -->
      <ui:Card Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="Install a model" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox x:Name="PullName" PlaceholderText="Any Ollama model name, e.g. qwen3.5:9b" Icon="{ui:SymbolIcon Search24}"
                        KeyDown="PullName_KeyDown" ToolTip="Type a model name and tag exactly as shown on ollama.com/library, then press Enter" />
            <ui:Button Grid.Column="1" Content="Install" Appearance="Primary" Icon="{ui:SymbolIcon ArrowDownload24}" Margin="8,0,0,0"
                       Click="PullByName_Click" ToolTip="Download this model into Ollama. Large models take a while; you can keep using the app." />
            <ui:Button Grid.Column="2" Content="Browse library" Icon="{ui:SymbolIcon Globe24}" Appearance="Transparent" Margin="8,0,0,0"
                       Click="Browse_Click" ToolTip="Open ollama.com/library in your browser to find more models" />
          </Grid>
        </StackPanel>
      </ui:Card>

      <!-- Downloads -->
      <ui:Card x:Name="DownloadsCard" Margin="0,0,0,12" Visibility="Collapsed">
        <StackPanel>
          <TextBlock Text="Downloading" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
          <ItemsControl x:Name="DownloadList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="{Binding Model}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <ProgressBar Value="{Binding Percent}" IsIndeterminate="{Binding Indeterminate}" Height="6" Margin="0,6,0,4" Maximum="100" />
                    <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                  </StackPanel>
                  <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon Dismiss24}" Content="Cancel" Margin="12,0,0,0" VerticalAlignment="Center"
                             Tag="{Binding}" Click="CancelDownload_Click"
                             ToolTip="Stop this download. Already-downloaded parts are kept, so installing again resumes." />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ui:Card>

      <!-- Installed -->
      <ui:Card Margin="0,0,0,18">
        <StackPanel>
          <TextBlock x:Name="InstalledHeader" Text="Installed" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
          <TextBlock x:Name="InstalledEmpty" Text="No models installed yet — pick one below." Visibility="Collapsed"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          <ItemsControl x:Name="InstalledList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="0,10">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="36" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="Cube24" FontSize="22" VerticalAlignment="Center" Foreground="{Binding IconBrush}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <Border CornerRadius="8" Padding="8,1" Margin="10,0,0,0" Background="{Binding BadgeBrush}" ToolTip="{Binding BadgeTip}"
                                Visibility="{Binding HasBadge, Converter={StaticResource BoolToVis}}">
                          <TextBlock Text="{Binding Badge}" FontSize="11" Foreground="White" />
                        </Border>
                      </StackPanel>
                      <TextBlock Text="{Binding Detail}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                      <ui:Button Content="Use" Icon="{ui:SymbolIcon CheckmarkCircle24}" Tag="{Binding Name}" Click="Use_Click"
                                 Visibility="{Binding CanUse, Converter={StaticResource BoolToVis}}"
                                 ToolTip="Make this the main model for Claude Code, Qwen Code and Chat on the Dashboard" />
                      <ui:Button Content="Delete" Icon="{ui:SymbolIcon Delete24}" Tag="{Binding Name}" Click="Delete_Click" Margin="8,0,0,0"
                                 ToolTip="Uninstall this model from Ollama and free its disk space (asks first)" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ui:Card>

      <!-- Catalog -->
      <TextBlock Text="Qwen models" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
      <TextBlock x:Name="CatalogHint" Text="Fit is estimated from your GPU memory." FontSize="13" Margin="0,2,0,10"
                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
      <ItemsControl x:Name="CatalogList" Margin="-6,0">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="3" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <ui:Card Margin="6" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
              <DockPanel>
                <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{Binding FitBrush}" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding FitText}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                  </StackPanel>
                  <ui:Button Grid.Column="1" Content="{Binding ButtonText}" Icon="{ui:SymbolIcon ArrowDownload24}" IsEnabled="{Binding CanInstall}"
                             Tag="{Binding Tag}" Click="CatalogInstall_Click" ToolTip="{Binding ButtonTip}" />
                </Grid>
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <ui:SymbolIcon Symbol="Star24" Filled="True" FontSize="14" Margin="8,0,0,0" Foreground="#E5B454"
                                   Visibility="{Binding Recommended, Converter={StaticResource BoolToVis}}" ToolTip="Recommended for this PC" />
                  </StackPanel>
                  <TextBlock Text="{Binding SubTitle}" FontFamily="Cascadia Mono, Consolas" FontSize="12" Margin="0,2,0,6"
                             Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                  <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
              </DockPanel>
            </ui:Card>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
