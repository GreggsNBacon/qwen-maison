<UserControl x:Class="Maison.Views.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28,4,28,28">

      <Grid Margin="0,0,0,18">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Setup" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
          <TextBlock Text="Everything needed to run Qwen locally on this PC. Safe to re-run: finished steps are skipped."
                     FontSize="14" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <ui:Button x:Name="BtnReinstall" Icon="{ui:SymbolIcon ArrowRepeatAll24}" Content="Reinstall everything" Padding="14,8" Margin="0,0,8,0" Click="ReinstallAll_Click"
                     ToolTip="Reinstall Ollama, Claude Code, Node.js and Qwen Code from scratch (latest versions). Your models and settings are kept." />
          <ui:Button x:Name="BtnAll" Appearance="Primary" Icon="{ui:SymbolIcon Rocket24}" Content="Set up everything"
                     Padding="16,8" Click="All_Click"
                     ToolTip="Run every unfinished step below in order: Ollama, the recommended model, Claude Code, Node.js and Qwen Code" />
        </StackPanel>
      </Grid>

      <!-- System summary -->
      <UniformGrid Columns="4" Margin="-6,0,-6,12">
        <ui:Card Margin="6">
          <StackPanel>
            <TextBlock Text="GPU" Style="{StaticResource MetricLabel}" />
            <TextBlock x:Name="SysGpu" Text="—" Style="{StaticResource MetricValue}" FontSize="16" />
            <TextBlock x:Name="SysGpuSub" Text="" Style="{StaticResource MetricSub}" />
          </StackPanel>
        </ui:Card>
        <ui:Card Margin="6">
          <StackPanel>
            <TextBlock Text="Memory" Style="{StaticResource MetricLabel}" />
            <TextBlock x:Name="SysRam" Text="—" Style="{StaticResource MetricValue}" FontSize="16" />
            <TextBlock Text="system RAM" Style="{StaticResource MetricSub}" />
          </StackPanel>
        </ui:Card>
        <ui:Card Margin="6">
          <StackPanel>
            <TextBlock Text="Disk" Style="{StaticResource MetricLabel}" />
            <TextBlock x:Name="SysDisk" Text="—" Style="{StaticResource MetricValue}" FontSize="16" />
            <TextBlock x:Name="SysDiskSub" Text="" Style="{StaticResource MetricSub}" />
          </StackPanel>
        </ui:Card>
        <ui:Card Margin="6">
          <StackPanel>
            <TextBlock Text="Recommended model" Style="{StaticResource MetricLabel}" />
            <TextBlock x:Name="SysRec" Text="—" Style="{StaticResource MetricValue}" FontSize="16" />
            <TextBlock x:Name="SysRecSub" Text="" Style="{StaticResource MetricSub}" />
          </StackPanel>
        </ui:Card>
      </UniformGrid>

      <!-- Steps -->
      <ui:Card Margin="0,0,0,12">
        <ItemsControl x:Name="StepList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="0,12">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Grid VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="{Binding Symbol}" Foreground="{Binding Brush}" FontSize="24"
                                   Visibility="{Binding NotBusy, Converter={StaticResource BoolToVis}}" />
                    <ui:ProgressRing IsIndeterminate="True" Width="22" Height="22" HorizontalAlignment="Left"
                                     Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}" />
                  </Grid>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                      <TextBlock Text="{Binding StatusText}" FontSize="12" Margin="10,2,0,0" Foreground="{Binding Brush}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Description}" FontSize="12.5" TextWrapping="Wrap" Margin="0,2,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ProgressBar Value="{Binding Progress}" Maximum="100" Height="5" Margin="0,8,0,0" MaxWidth="520" HorizontalAlignment="Left" Width="520"
                                 Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Content="{Binding UninstallText}" MinWidth="96" Margin="0,0,8,0" Appearance="Transparent"
                               Tag="{Binding}" Click="Uninstall_Click" IsEnabled="{Binding NotBusy}" ToolTip="{Binding UninstallTip}"
                               Visibility="{Binding ShowUninstall, Converter={StaticResource BoolToVis}}" />
                    <ui:Button Content="{Binding ButtonText}" MinWidth="110"
                               Tag="{Binding}" Click="Step_Click" IsEnabled="{Binding CanRun}" ToolTip="{Binding ButtonTip}"
                               Visibility="{Binding ShowButton, Converter={StaticResource BoolToVis}}" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ui:Card>

      <ui:CardExpander Icon="{ui:SymbolIcon WindowConsole20}" IsExpanded="True">
        <ui:CardExpander.Header>
          <StackPanel>
            <TextBlock Text="Installer output" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock x:Name="LastLine" Text="Nothing run yet" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          </StackPanel>
        </ui:CardExpander.Header>
        <TextBox x:Name="Output" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap"
                 Height="200" VerticalScrollBarVisibility="Auto" />
      </ui:CardExpander>
    </StackPanel>
  </ScrollViewer>
</UserControl>
